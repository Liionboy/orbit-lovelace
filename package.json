{
  "name": "orbit-lovelace",
  "version": "1.9.0",
  "private": true,
  "type": "module",
  "description": "Orbit Lovelace and companion Home Assistant card suite",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
