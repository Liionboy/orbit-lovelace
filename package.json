{
  "name": "orbit-lovelace",
  "version": "1.17.0",
  "private": true,
  "type": "module",
  "description": "Orbit Lovelace and companion Home Assistant card suite",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test:suite": "node --test --test-concurrency=1 test/suite.test.mjs test/themes.test.mjs test/controls.test.mjs test/compact.test.mjs test/luma-appearance.test.mjs test/switch-state-icon.test.mjs test/frigate-live.test.mjs test/temperature.test.mjs test/gauge.test.mjs",
    "test:upstream": "node scripts/test-upstream.mjs",
    "test": "npm run test:suite && npm run test:upstream",
    "test:browser": "node test/browser.mjs",
    "test:themes:browser": "node test/themes.browser.mjs",
    "test:profiles:browser": "node test/profiles.browser.mjs",
    "test:controls:browser": "node test/controls.browser.mjs",
    "test:compact:browser": "node test/compact.browser.mjs",
    "test:compact:baseline": "node test/compact-baseline.browser.mjs",
    "test:compact:density": "node test/compact-density.browser.mjs",
    "test:compact:tile": "node test/compact-tile.browser.mjs",
    "test:welcome:browser": "node test/welcome-normal.browser.mjs",
    "test:compact:luma": "node test/compact-luma.browser.mjs",
    "test:compact:identity": "node test/compact-identity.browser.mjs",
    "test:compact:media": "node test/compact-media.browser.mjs",
    "test:luma:appearance": "node test/luma-appearance.browser.mjs",
    "test:switch:icon": "node test/switch-state-icon.browser.mjs",
    "test:frigate:live": "node test/frigate-live.browser.mjs",
    "test:temperature:browser": "node test/temperature.browser.mjs",
    "test:gauge:browser": "node test/gauge.browser.mjs",
    "test:prism:browser": "node test/prism.browser.mjs"
  }
}
